# App
APP_NAME=hallucination-detector
APP_ENV=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./database/app.db

# Auth - CHANGE THIS in any real deployment
SECRET_KEY=dev-only-change-this-secret-key-please
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Logging
LOG_LEVEL=INFO
LOG_DIR=./logs

# LLM (used starting Phase 3 - present now so config layer is stable)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# FEVER Dataset (Optional second evidence source; JSONL file with {"claim", "label", "evidence_text", "wiki_page"})
FEVER_DATASET_PATH=./knowledge_base/fever_data.jsonl

